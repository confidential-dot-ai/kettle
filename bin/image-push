#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# push built image to Docker Hub
(
    cd "$REPO_ROOT/target/image"
    rm -f image-manifest.json
    oras push "docker.io/confidentialai/kettle-server:latest" ./* \
    --annotation "org.opencontainers.image.url=https://docker.io/confidentialai/kettle-server" \
    --annotation "org.opencontainers.image.source=https://github.com/confidential-dot-ai/kettle" \
    --artifact-type application/vnd.steep.cvm-image.v1 \
    --export-manifest image-manifest.json

    # Assert the registry resolves the manifest by the same digest the
    # orchestrator computes at runtime (sha256 of the exported manifest bytes,
    # surfaced via GET /config). Catches any registry/runtime digest divergence
    # here at deploy time rather than later via a kettle verify mismatch.
    DIGEST="sha256:$(sha256sum image-manifest.json | cut -d' ' -f1)"
    oras manifest fetch "docker.io/confidentialai/kettle-server@${DIGEST}" >/dev/null
    echo "verified pushed image digest: docker.io/confidentialai/kettle-server@${DIGEST}"
)
