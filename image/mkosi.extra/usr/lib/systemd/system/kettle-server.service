[Unit]
Description=Kettle build server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/bin/bash -lc 'exec /usr/local/bin/kettle-server'
Restart=no
User=kettle
Group=kettle
NoNewPrivileges=yes
CacheDirectory=kettle-server
Environment=CARGO_HOME=/var/cache/kettle-server/cargo
# sev-guest grants the server /dev/sev-guest (measured udev rule). Builds run
# untrusted code and must not inherit it, so the server drops supplementary
# groups before exec'ing build tools; that needs CAP_SETGID and nothing else.
SupplementaryGroups=sev-guest
AmbientCapabilities=CAP_SETGID
CapabilityBoundingSet=CAP_SETGID

[Install]
WantedBy=multi-user.target
